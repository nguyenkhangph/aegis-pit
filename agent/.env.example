# Copy to .env and edit. The agent talks to Gno.land only through gnomcp (https://mcp.gno.dev).
# Install gnomcp:  go install github.com/gnoverse/gno-mcp/cmd/gnomcp@latest   (binary in ~/go/bin)
GNOMCP_BIN=gnomcp
GNOMCP_PROFILE=testnet            # gnomcp built-in profile = onyx-1
AEGIS_REALM=gno.land/r/<your-g1-address>/aegis_pit/v2
# session = act as you through a session YOU approve with gnokey (npm run session)
# agent   = sign with gnomcp's own agent key (gno_key_generate)
AGENT_IDENTITY=session
MASTER_ADDRESS=<your public g1 address>
BOX_ID=1
