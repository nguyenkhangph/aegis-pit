# Copy to .env and edit. Keys stay in your local gnokey keybase; this agent never sees a private key.
GNO_RPC=https://rpc.onyx.testnets.gno.land:443
GNO_CHAIN_ID=onyx-1
# Your address-namespaced realm path after deploy (scripts/deploy-onyx.sh prints it)
AEGIS_REALM=gno.land/r/<your-g1-address>/aegis_pit
# gnokey key names (gnokey list)
AGENT_KEY=agent
FIGHTER_KEY=alice
# Box the agent is allowed to spend from
BOX_ID=1
